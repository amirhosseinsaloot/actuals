# Copy to .env and fill in as needed:  cp .env.example .env

# --- AI ---
# Required for the assistant; leave unset to disable AI analysis.
OPENAI_API_KEY=
# Any OpenAI model id that supports the Responses API + tool calling.
OPENAI_MODEL=gpt-4o-mini

# --- Frontend ---
# Base URL the browser uses to reach the backend (inlined at build time).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Backend / DB (override only if needed) ---
# Postgres is the target database; docker-compose sets this for you. Unset, the
# backend falls back to a local SQLite file (backend/db.sqlite3) so it runs
# without a database server.
# DATABASE_URL=postgres://budget:budget@db:5432/budget
# DJANGO_DEBUG=1
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# App secret key. A dev fallback is used if unset; set a real one for any shared
# use:  python -c "import secrets; print(secrets.token_urlsafe(50))"
# DJANGO_SECRET_KEY=
